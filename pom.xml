<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      - 是什么：这是整个微服务项目的「父工程」（parent POM），只负责统一版本、不写业务代码。
      - 干什么：
        - 声明所有子模块（modules），一个服务一个 module；
        - 继承 Spring Boot 官方 parent，统一 Boot 相关依赖/插件版本；
        - 在 dependencyManagement 里统一仲裁 Spring Cloud / Alibaba / 第三方库的版本。
      - 为什么：拆成多个服务后，每个服务的 pom 都要引一堆依赖，如果不在这里统一版本，
        各服务各写各的版本，很快就会版本冲突、升级地狱。父工程就是「版本清单」。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.wangguangyang</groupId>
    <artifactId>my-project-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- packaging=pom：父工程本身不打 jar，只是一个聚合/管理工程 -->
    <packaging>pom</packaging>
    <name>my-project-parent</name>
    <description>抢课系统微服务父工程：统一管理各模块版本与依赖</description>

    <!-- 子模块：以后每拆一个服务，就在这里加一行 <module> -->
    <modules>
        <module>my-project-service</module>
        <module>gateway</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Cloud 版本（Northfields 线，对应 Spring Boot 3.5.x） -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <!-- Spring Cloud Alibaba 版本（对应 Spring Boot 3.5.x + Spring Cloud 2025.0.x） -->
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
    </properties>

    <!--
      dependencyManagement 是什么：只「声明版本」，不「引入依赖」。
      干了什么：子模块引依赖时可以不写 <version>，由这里统一给出版本。
      为什么：BOM（Bill of Materials）是一张版本清单，保证所有模块用同一套版本、不冲突。
        - import 的 BOM 负责管 Spring Cloud / Alibaba 组件版本；
        - 下面单独列的几个是 Spring Boot 和 Spring Cloud 都不管的第三方库，需手动声明版本。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud 官方 BOM：仲裁 Gateway / OpenFeign / LoadBalancer 等版本 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 阿里 BOM：仲裁 Nacos / Sentinel / Seata 等版本 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 以下是 Boot 和 Cloud 都不管的第三方库，版本统一在这里声明 -->
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>5.3.2</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>3.52.0</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>3.5.7</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>0.12.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>0.12.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
